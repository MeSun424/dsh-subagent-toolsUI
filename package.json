{
  "name": "dsh-subagent-tools-ui",
  "version": "0.4.11-local",
  "description": "Per-session user lock for DeepSeek Harness subagent routes, layered on the official 0.1.5 tools.",
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "pack:local": "npm run build:client && npm pack",
    "test:lock": "node --test test/lock.test.mjs"
  },
  "main": "lib/service-plugin.js",
  "exports": {
    ".": "./lib/service-plugin.js",
    "./tool": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "install-preset.ps1",
    "install-preset.sh",
    "scripts",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "delegation"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tool-subagent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeSun424/dsh-subagent-toolsUI.git"
  },
  "homepage": "https://github.com/MeSun424/dsh-subagent-toolsUI#readme",
  "bugs": {
    "url": "https://github.com/MeSun424/dsh-subagent-toolsUI/issues"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
